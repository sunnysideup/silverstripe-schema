{
    "name": "bramdeleeuw/silverstripe-schema",
    "description": "Add schema to a Silverstripe page",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "schema",
        "schema.org",
        "structured data",
        "knowledge graph"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Bram de Leeuw",
            "email": "bram@broarm.nl"
        }
    ],
    "require": {
        "silverstripe/framework": "^6.0",
        "spatie/schema-org": "^4"
    },
    "autoload": {
        "psr-4": {
            "Broarm\\Schema\\": "src"
        }
    },
    "yet-to-update": {
        "sunnysideup/array2ul": {
            "section": "require",
            "current": "dev-main",
            "reason": "no-compatible-stable-release"
        }
    }
}
